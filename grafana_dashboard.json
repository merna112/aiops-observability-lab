{
  "dashboard": {
    "id": null,
    "uid": "aiops-observability",
    "title": "AIOps Observability Dashboard",
    "tags": [
      "aiops",
      "observability"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate per Endpoint (RPS)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum by (method, path) (rate(http_requests_total[1m]))",
            "legendFormat": "{{method}} {{path}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Error Rate % per Endpoint",
        "type": "timeseries",
        "targets": [
          {
            "expr": "100 * sum by (method, path) (rate(http_errors_total[1m])) / clamp_min(sum by (method, path) (rate(http_requests_total[1m])), 0.0001)",
            "legendFormat": "{{method}} {{path}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "P50 / P95 / P99 Latency per Endpoint",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le, method, path) (rate(http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "P50 {{method}} {{path}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le, method, path) (rate(http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "P95 {{method}} {{path}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le, method, path) (rate(http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "P99 {{method}} {{path}}",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Error Category Breakdown (Stacked)",
        "type": "timeseries",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "stacking": {
                "mode": "normal",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum by (path, error_category) (rate(http_errors_total[1m]))",
            "legendFormat": "{{path}} {{error_category}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 5,
        "title": "Anomaly Window Marker",
        "type": "timeseries",
        "targets": [
          {
            "expr": "max(anomaly_window_active)",
            "legendFormat": "anomaly_window_active",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "templating": {
      "list": []
    }
  },
  "overwrite": true
}

{
    "dashboard": {
        "id": null,
        "title": "AIOps Observability Dashboard",
        "tags": [
            "aiops",
            "observability"
        ],
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "Request Rate per Endpoint (RPS)",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(http_requests_total[5m])",
                        "legendFormat": "{{method}} {{path}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Error Rate % per Endpoint",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(http_errors_total[5m]) / rate(http_requests_total[5m]) * 100",
                        "legendFormat": "{{method}} {{path}} {{error_category}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "P50/P95/P99 Latency per Endpoint",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "P50 {{method}} {{path}}"
                    },
                    {
                        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "P95 {{method}} {{path}}"
                    },
                    {
                        "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "P99 {{method}} {{path}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 8
                }
            },
            {
                "id": 4,
                "title": "Error Category Breakdown",
                "type": "barchart",
                "targets": [
                    {
                        "expr": "sum(rate(http_errors_total[5m])) by (error_category)",
                        "legendFormat": "{{error_category}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 16
                }
            }
        ],
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "timepicker": {},
        "templating": {
            "list": []
        },
        "annotations": {
            "list": [
                {
                    "name": "Anomaly Window",
                    "datasource": "-- Grafana --",
                    "enable": true,
                    "hide": false,
                    "iconColor": "red",
                    "type": "annotation"
                }
            ]
        },
        "refresh": "5s",
        "schemaVersion": 27,
        "version": 0,
        "links": []
    }
}